{
  "rules": {
    "sessions": {
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('createdBy').val() === auth.uid) || (data.exists() && data.child('createdBy').val() === auth.uid))",
        "participants": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('sessions').child($sessionId).child('createdBy').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name', 'role']) && newData.child('name').isString() && newData.child('name').val().length <= 80 && newData.child('role').isString()"
          }
        },
        "boardText": {
          ".write": "auth != null && root.child('sessions').child($sessionId).child('createdBy').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 50000"
        },
        "announcement": {
          ".write": "auth != null && root.child('sessions').child($sessionId).child('createdBy').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 300"
        }
      }
    }
  }
}